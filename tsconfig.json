{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    ".vitepress/config.mts",
    ".vitepress/config/*.mts",
    ".vitepress/plugins/*.ts",
    ".vitepress/utils/*.ts"
  ]
}
